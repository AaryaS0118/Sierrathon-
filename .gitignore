# KiCad lock files (exist while a file is open in KiCad)
*.lck
~*.lck
# KiCad backups / autosaves / caches
*-backups/
_autosave-*
\#auto_saved_files\#
fp-info-cache
*.bak
*.bck
*.000
*.tmp
# Per-user view settings (open layers, zoom) - causes pointless conflicts
*.kicad_prl
# Office temp files
~$*
# OS junk
Thumbs.db
desktop.ini
.DS_Store
# KiCad 10 local history (has its own internal git repo)
.history/
